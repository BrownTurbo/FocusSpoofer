{
  "manifest_version": 3,
  "name": "Focus Pro",
  "version": "1.2.3",
  "description": "Advanced visibility and focus spoofing",
  "browser_specific_settings": {
    "gecko": {
      "id": "focus-spoofer@brownturbo",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "telemetry": false,
        "hotfix": false,
        "required": ["none"]
      }
    }
  },
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["extension.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "author": "John Magdy Lotfy (Zorono)",
  "developer": {
    "name": "John Magdy Lotfy (Zorono)",
    "url": "https://github.com/Zorono"
  }
}
